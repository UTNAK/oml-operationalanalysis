@dc:title "Example Description"
@dc:creator "Example Company"
@dc:rights "Copyright 2019, by Example Company"
description <http://opencaesar.io/example/description/operation#> as operation {

	uses <http://purl.org/dc/elements/1.1/> as dc

	uses <http://opencaesar.io/example/vocabulary/operational#> as operational

	uses <http://imce.jpl.nasa.gov/foundation/base#> as base

	uses <http://imce.jpl.nasa.gov/foundation/mission#> as mission

	// Example concept instance
	instance m1 : operational:Mission [
		base:hasIdentifier "M.01"
		base:hasDescription "Prevent any collision between train and road vehicles"
	]

	instance m2 : operational:Mission [
		base:hasIdentifier "M.02"
		base:hasDescription "Ensure fluidity in rail and road vehicle traffic"
	]

	instance c1 : operational:Capability [
		base:hasIdentifier "C.01"
		base:hasDescription "Acknowledge approaching trains"
		operational:isRequiredBy m1
		operational:isRequiredBy m2
	]

	instance c2 : operational:Capability [
		base:hasIdentifier "C.02"
		base:hasDescription "Forbid the simultaneous access of vehicles and trains to the crossing"
		operational:isRequiredBy m1
	]

	instance o2_1 : operational:OperationalActivity [
		operational:mapsTo c2
	]

	instance c3 : operational:Capability [
		base:hasIdentifier "C.03"
		base:hasDescription "Acknowledge approaching road vehicles"
		operational:isRequiredBy m1
		operational:isRequiredBy m2
	]

	instance c5 : operational:Capability [
		base:hasIdentifier "C.04"
		base:hasDescription "Temporarily favor road traffic"
		operational:isRequiredBy m2
	]

	instance traffic : operational:Entity [
		// base:aggregates c4 // error :  aggregate only Entity
		base:aggregates road-vehicle
		base:hasCanonicalName "Traffic"
	]

	instance train : operational:Entity [
		base:hasCanonicalName "Train"
	]

	instance road-vehicle : operational:RoadVehicle [
		base:hasCanonicalName "Road Vehicle"
		base:aggregates cars
		base:aggregates bus
		base:aggregates heavy-trucks
		base:aggregates two-wheeled-vehicles	
	]

	instance bus : operational:Entity [
		base:hasCanonicalName "Bus"
	]

	instance cars : operational:Entity[
		base:hasCanonicalName "Cars"
	]

	instance heavy-trucks : operational:Entity[
		base:hasCanonicalName "Heavy Trucks"
	]

	instance two-wheeled-vehicles : operational:Entity[
		base:hasCanonicalName "Two Wheeled Vehicles"
	]

	instance train-arriving-in-the-station : operational:Entity[
		base:hasCanonicalName "Train Arriving in the Station"
	]

	instance train-leaving : operational:Entity[
		base:hasCanonicalName "Train Leaving"
	]

	// instance distressed-party-01 :  operational:OperationalRole[
	// 	operational:performs transmit-distress-signal
	// ]
	// instance distressed-party-02 :  operational:OperationalRole
	// instance sar-monitor-01 :  operational:OperationalRole[
	// 	operational:performs receive-distress-and-transmit-new-track-or-track-update
	// ]
	// instance sar-monitor-02 :  operational:OperationalRole

	// instance transmit-distress-signal : operational:OperationalActivity
	// instance receive-distress-and-transmit-new-track-or-track-update : operational:OperationalActivity
	// relation instance distress-01 : operational:Exchange [
	// 	from transmit-distress-signal
	// 	to receive-distress-and-transmit-new-track-or-track-update
	// ]

}
