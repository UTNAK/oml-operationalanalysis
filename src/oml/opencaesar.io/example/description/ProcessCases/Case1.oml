@dc:title "Example Description"
@dc:creator "Example Company"
@dc:rights "Copyright 2019, by Example Company"
description <http://opencaesar.io/example/description/ProcessCases/Case1#> as case1 {

	uses <http://purl.org/dc/elements/1.1/> as dc

	uses <http://opencaesar.io/example/vocabulary/process#> as process

	uses <http://imce.jpl.nasa.gov/foundation/base#> as base

    uses <http://www.w3.org/2001/XMLSchema#> as xsd

	// Example concept instance
	instance p1 : process:PurchasedItem [
		process:Status "unblocked"
		process:Amount "12000"
        process:isHandledBy apply-01
        process:isHandledBy approve-01
        process:isHandledBy receive-01
	]
    instance apply-01 : process:Apply [
        process:handles p1
        process:isPerformedBy A
        process:invokes approve-01
        process:TimeStamp "2024-06-15T10:00:00"
    ]
    instance approve-01 : process:Approve [
        process:handles p1
        process:isPerformedBy B
        process:invokes receive-01
        process:TimeStamp "2024-06-16T15:30:00"
    ]
    instance receive-01 : process:Receive [
        process:handles p1
        process:isPerformedBy C
        process:TimeStamp "2024-06-17T09:45:00"
    ]
    instance A : process:Purchasing [
        process:performs apply-01
    ]
    instance B : process:Manager [
        process:performs approve-01
    ]
    instance C : process:Leader [
        process:performs receive-01
    ]
	

	// instance distressed-party-01 :  operational:OperationalRole[
	// 	operational:performs transmit-distress-signal
	// ]
	// instance distressed-party-02 :  operational:OperationalRole
	// instance sar-monitor-01 :  operational:OperationalRole[
	// 	operational:performs receive-distress-and-transmit-new-track-or-track-update
	// ]
	// instance sar-monitor-02 :  operational:OperationalRole

	// instance transmit-distress-signal : operational:OperationalActivity
	// instance receive-distress-and-transmit-new-track-or-track-update : operational:OperationalActivity
	// relation instance distress-01 : operational:Exchange [
	// 	from transmit-distress-signal
	// 	to receive-distress-and-transmit-new-track-or-track-update
	// ]

}