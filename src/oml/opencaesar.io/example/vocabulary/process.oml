@dc:title "Example Vocabulary"
@dc:creator "Example Company"
@dc:rights "Copyright 2019, by Example Company"
vocabulary <http://opencaesar.io/example/vocabulary/process#> as process {

	extends <http://purl.org/dc/elements/1.1/> as dc

	extends <http://www.w3.org/2000/01/rdf-schema#> as rdfs

	extends <http://imce.jpl.nasa.gov/foundation/base#> as base

    extends <http://www.w3.org/2001/XMLSchema#> as xsd


    concept Role

    concept Stuff < Role
    concept Leader < Role
    concept Manager < Role
    concept Purchasing < Role

    concept Activity < base:IdentifiedElement

    concept Apply < Activity
    concept Approve < Activity
    concept Receive < Activity

    relation entity Performs[
        from Role
        to Activity
        forward performs
        reverse isPerformedBy
        functional
    ]

    relation entity Invokes[
        from Activity
        to Activity
        forward invokes
        reverse isInvokedBy
    ]

    concept PurchasedItem < base:IdentifiedElement

    relation entity Handles[
        from Activity
        to PurchasedItem
        forward handles
        reverse isHandledBy
        functional
    ]

    scalar property Status[
        domain PurchasedItem
        range xsd:string
        functional
    ]

    scalar property Amount[
        domain PurchasedItem
        range xsd:string
        // range xsd:integer
        functional
    ]

    scalar property TimeStamp[
        domain Activity
        range xsd:string
        // range xsd:dateTimeStamp
        functional
    ]


	// @rdfs:label "Mission"
